# Server-only secrets — never prefix with VITE_
# Copy to .env and fill ONE provider for the most reliable delivery

# Option A — Web3Forms (recommended, free): https://web3forms.com
# Create a key with destination: aruljothi128r@gmail.com
WEB3FORMS_ACCESS_KEY=

# Option B — Resend: https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Option C — Formspree: https://formspree.io  (form id only)
FORMSPREE_FORM_ID=

# If none are set, the browser uses FormSubmit.co (must use npm run dev / a real URL,
# not open the HTML file directly). First FormSubmit email may need inbox confirmation.

# GitHub — exact contribution graph (includes private commits when logged-in view differs)
# Create at: https://github.com/settings/tokens — scope: read:user
GITHUB_TOKEN=
